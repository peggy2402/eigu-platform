{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.eigu.platform.desktop",
  "productName": "EIGU Platform",
  "copyright": "Copyright © 2026 EIGU Platform",
  "directories": {
    "output": "dist/packages/desktop-installer",
    "app": "dist/apps/desktop"
  },
  "files": [
    "**/*"
  ],
  "asarUnpack": [
    "assets/**/*"
  ],
  "extraResources": [
    {
      "from": "apps/desktop/src/assets",
      "to": "assets",
      "filter": ["**/*"]
    }
  ],
  "publish": [
    {
      "provider": "github",
      "owner": "peggy2402",
      "repo": "eigu-platform",
      "releaseType": "release"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "artifactName": "EIGU-Platform-Setup-${version}.${ext}",
    "icon": "apps/desktop/src/assets/img/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "EIGU Platform"
  },
  "mac": {
    "identity": null,
    "target": [
      {
        "target": "pkg",
        "arch": ["universal"]
      },
      {
        "target": "zip",
        "arch": ["x64", "arm64"]
      }
    ],
    "artifactName": "EIGU-Platform-${version}-${arch}.${ext}",
    "category": "public.app-category.utilities",
    "icon": "apps/desktop/src/assets/img/icon.icns"
  },
  "pkg": {
    "scripts": "apps/desktop/build/pkg-scripts",
    "installLocation": "/Applications"
  }
}
