// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String     @id @default(uuid())
  email                String     @unique
  username             String?    @unique
  passwordHash         String
  role                 String     @default("user") // admin, staff, user
  isVerified           Boolean    @default(false)
  isBanned             Boolean    @default(false)
  bannedUntil          DateTime?
  banReason            String?
  lastActiveAt         DateTime?
  lastIp               String?
  lastOs               String?
  lastDevice           String?
  hiddenTabs           String[]   @default([])

  otpCode              String?
  otpExpiresAt         DateTime?

  refreshToken         String?
  passwordResetToken   String?
  passwordResetExpires DateTime?

  balance              Decimal    @default(0.00) @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  proxies             Proxy[]
  accounts            TikTokAccount[]
  feedbacks           Feedback[]
  depositTransactions DepositTransaction[]
  subscriptions       UserSubscription[]
  news                News[]
  newsComments        NewsComment[]
}

model Proxy {
  id        String   @id @default(uuid())
  ip        String
  port      Int
  username  String?
  password  String?
  country   String
  status    String   @default("active") // active, dead, flagged
  
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  accounts  TikTokAccount[]
}

model TikTokAccount {
  id           String   @id @default(uuid())
  username     String   @unique
  cookies      String?  // JSON string
  status       String   @default("active") // active, shadowbanned, banned
  
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  
  proxyId      String?
  proxy        Proxy?   @relation(fields: [proxyId], references: [id])
  
  tasks        VideoTask[]
}

model VideoTask {
  id             String   @id @default(uuid())
  sourceVideoUrl String
  status         String   @default("pending") // pending, processing, uploaded, failed
  
  accountId      String
  account        TikTokAccount @relation(fields: [accountId], references: [id])
  
  createdAt      DateTime @default(now())
}

model Feedback {
  id        String   @id @default(uuid())
  content   String
  imageUrl  String?
  
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  content   String
  target    String   @default("all") // all, user, staff
  isRead    Boolean  @default(false)
  expiresAt DateTime? // 1h, 12h, 24h, 7d, 30d
  createdAt DateTime @default(now())
}

model ChatMessage {
  id            String    @id @default(uuid())
  userEmail     String    @default("guest@eigu.vn")
  username      String?
  sender        String    // user, ai, staff
  senderEmail   String?
  message       String
  status        String    @default("sent") // sent, seen
  parentMsgId   String?
  parentMsgText String?
  createdAt     DateTime  @default(now())

  @@index([userEmail])
  @@index([createdAt])
}

model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

enum RotationStrategy {
  MANUAL
  DAILY
  WEEKLY
  MONTHLY
  CRON
}

enum HistoryStatus {
  ACTIVE
  GRACE_PERIOD
  EXPIRED
  ROLLED_BACK
  DISABLED
}

model SecuritySetting {
  id                      String           @id @default(uuid())
  module                  String           @unique // e.g. "AUTH", "USERS", "PAYMENT", "AI", "NOTIFICATION"
  activeCode              String           @unique
  previousCode            String?
  gracePeriodExpiresAt    DateTime?
  emergencyDisabled       Boolean          @default(false)
  rotationStrategy        RotationStrategy @default(MANUAL)
  autoRotateIntervalDays  Int              @default(7)
  nextRotationAt          DateTime?
  updatedById             String?
  updatedAt               DateTime         @updatedAt
  createdAt               DateTime         @default(now())

  @@index([module])
  @@index([activeCode])
}

model ObfuscationHistory {
  id          String        @id @default(uuid())
  module      String
  code        String
  status      HistoryStatus @default(ACTIVE)
  createdById String?
  reason      String?
  expiredAt   DateTime?
  createdAt   DateTime      @default(now())

  @@index([module, status])
  @@index([code])
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String?
  userId     String?
  userEmail  String?
  username   String?
  userRole   String?
  action     String   // e.g. "LOGIN", "LOGOUT", "ROTATE_CODE", "CUT_VIDEO", "CHANGE_ROLE", "UPDATE_SETTINGS"
  module     String
  ipAddress  String?
  userAgent  String?
  device     String?
  payload    String?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([userId])
  @@index([userEmail])
  @@index([userRole])
  @@index([module])
  @@index([action])
  @@index([createdAt])
}

model PricingModule {
  id          String             @id @default(uuid())
  slug        String             @unique // "cut", "ai-video", "ai-studio", "reup", "hot-niche", "bulk-download"
  name        String
  tagline     String
  icon        String
  isActive    Boolean            @default(true)
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  tiers       PricingTier[]
  subscriptions UserSubscription[]
}

model PricingTier {
  id            String               @id @default(uuid())
  moduleId      String
  module        PricingModule        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  code          String               // "trial", "basic", "pro", "team", "enterprise"
  label         String
  tagline       String
  price         Decimal              @db.Decimal(14, 2)
  originalPrice Decimal              @default(0.00) @db.Decimal(14, 2)
  discount      Int                  @default(0)
  machines      Int                  @default(1)
  threads       Int                  @default(4)
  resolution    String               @default("1080p")
  billingPeriod String               @default("monthly")
  trialDays     Int                  @default(0)
  badgeId       String?
  badge         PricingBadge?        @relation(fields: [badgeId], references: [id], onDelete: SetNull)
  isActive      Boolean              @default(true)
  sortOrder     Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  features      PricingTierFeature[]
  subscriptions UserSubscription[]

  @@unique([moduleId, code])
}

model PricingBadge {
  id          String        @id @default(uuid())
  code        String        @unique
  name        String
  colorConfig String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tiers       PricingTier[]
}

model PricingTierFeature {
  id        String      @id @default(uuid())
  tierId    String
  tier      PricingTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  text      String
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
}

model DepositTransaction {
  id            String    @id @default(uuid())
  code          String    @unique
  fullContent   String
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Decimal   @db.Decimal(14, 2)
  status        String    @default("PENDING") // PENDING, COMPLETED, CANCELLED, EXPIRED
  paymentMethod String    @default("sepay_bank")
  sepayTransId  String?
  bankName      String?
  accountNumber String?
  content       String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([code])
  @@index([status])
}

model UserSubscription {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId     String
  module       PricingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  tierId       String
  tier         PricingTier   @relation(fields: [tierId], references: [id], onDelete: Cascade)
  status       String        @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED
  expiresAt    DateTime?
  machines     Int           @default(1)
  threads      Int           @default(4)
  resolution   String        @default("1080p")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([userId, moduleId])
  @@index([userId])
  @@index([moduleId])
}

model NewsCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  news        News[]
}

model NewsTag {
  id        String            @id @default(uuid())
  name      String            @unique
  slug      String            @unique
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  news      NewsTagRelation[]
}

model NewsTagRelation {
  newsId String
  tagId  String
  news   News    @relation(fields: [newsId], references: [id], onDelete: Cascade)
  tag    NewsTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([newsId, tagId])
  @@index([newsId])
  @@index([tagId])
}

model News {
  id             String            @id @default(uuid())
  title          String
  slug           String            @unique
  summary        String?           @db.Text
  content        String            @db.Text
  thumbnail      String?
  gallery        String[]          @default([])
  categoryId     String?
  category       NewsCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags           NewsTagRelation[]
  status         String            @default("draft") // draft, published, archived
  isFeatured     Boolean           @default(false)
  authorId       String?
  authorName     String?
  author         User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  publishedAt    DateTime?
  deletedAt      DateTime?
  viewCount      Int               @default(0)
  likeCount      Int               @default(0)
  commentCount   Int               @default(0)
  readingTime    Int               @default(1)
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  comments       NewsComment[]

  @@index([slug])
  @@index([status])
  @@index([categoryId])
  @@index([isFeatured])
  @@index([createdAt])
}

model NewsComment {
  id           String                @id @default(uuid())
  newsId       String
  news         News                  @relation(fields: [newsId], references: [id], onDelete: Cascade)
  parentId     String?
  parent       NewsComment?          @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      NewsComment[]         @relation("CommentReplies")
  userId       String?
  user         User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName     String
  userAvatar   String?
  userRole     String?               @default("user")
  content      String                @db.Text
  likeCount    Int                   @default(0)
  dislikeCount Int                   @default(0)
  status       String                @default("approved") // approved, pending, hidden
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  deletedAt    DateTime?
  reactions    NewsCommentReaction[]
  reports      NewsCommentReport[]

  @@index([newsId])
  @@index([parentId])
  @@index([status])
  @@index([createdAt])
}

model NewsCommentReaction {
  id        String      @id @default(uuid())
  commentId String
  comment   NewsComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  type      String      // "like" or "dislike"
  createdAt DateTime    @default(now())

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
}

model NewsCommentReport {
  id        String      @id @default(uuid())
  commentId String
  comment   NewsComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String?
  reason    String
  createdAt DateTime    @default(now())

  @@index([commentId])
}



